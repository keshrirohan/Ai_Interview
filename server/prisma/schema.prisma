generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Required for all Prisma CLI commands (migrate, generate, introspect).
  // The PrismaPg driver adapter in lib/prisma.js also reads this value at
  // runtime, so both paths use the same env variable.
  url      = env("DATABASE_URL")
}

// ===========================
// User Model
// ===========================

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String

  role      Role     @default(USER)
  plan      Plan     @default(FREE)
  interviewsUsed Int  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  interviews      Interview[]
  resume           Resume?
  subscription     Subscription?
  payments         Payment[]
  overallReport    OverallReport?
  contactMessages  ContactMessage[]
}

model Interview {
  id              String   @id @default(cuid())
  userId          String 
  user            User     @relation(fields: [userId], references: [id])

  conversation    Json?
  jobDescription  String

  currentQuestion Int @default(1)
  maxQuestions    Int @default(10)

  difficulty      Difficulty
  status          InterviewStatus @default(IN_PROGRESS)

  startedAt       DateTime @default(now())
  completedAt     DateTime?

  report          Report?

  @@index([userId])
  @@index([status])
  @@index([userId, status])
}

model Report {
  id              String   @id @default(cuid())
  interviewId     String   @unique
  interview       Interview @relation(fields: [interviewId], references: [id])

  score           Float
  communication   Float
  technical       Float
  confidence      Float
  problemSolving  Float

  strengths       Json
  weaknesses      Json
  recommendations Json
  summary         String

  createdAt       DateTime @default(now())
}

model OverallReport {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])

  overallScore    Float
  technical       Float
  communication   Float
  confidence      Float
  problemSolving  Float

  strengths       Json
  weaknesses      Json
  recommendations Json
  summary         String
  totalInterviews Int

  updatedAt       DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  name      String
  email     String
  subject   String?
  message   String
  status    String   @default("UNREAD") // UNREAD | READ | REPLIED
  createdAt DateTime @default(now())
}

model Resume {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id])
  fileUrl    String
  parsedText String
  uploadedAt DateTime @default(now())
}

model Subscription {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id])
  plan      Plan
  active    Boolean   @default(true)
  expiresAt DateTime?
}

model Payment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Float
  status    String
  paymentId String
  createdAt DateTime @default(now())
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  GOLD
  PLATINUM
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum InterviewStatus {
  IN_PROGRESS
  COMPLETED
}